# Copy to .env.local (ignored by Git) or run `npm run setup`.
# Never commit real values.

NODE_ENV=development
PORT=4310
APP_ORIGIN=http://localhost:4310

# GitHub account or organization whose repositories are monitored.
TARGET_ACCOUNT=vibecoded-projects-2

ADMIN_USERNAME=admin
# At least 20 characters.
ADMIN_PASSWORD=

# Leave empty to use embedded PGlite at PGLITE_PATH during development.
DATABASE_URL=
PGLITE_PATH=.data/postgres

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
REVIEW_MODEL=claude-opus-5-5

MONTHLY_BUDGET_USD=50
MAX_REVIEW_INPUT_TOKENS=100000
MAX_REVIEW_OUTPUT_TOKENS=8000
MAX_PR_FILES=100
MAX_CONTEXT_BYTES=300000

# Local mode runs the worker inside the web process.
RUN_WORKER=true
